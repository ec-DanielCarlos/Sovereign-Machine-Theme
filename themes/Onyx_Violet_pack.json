  "tokenColors": [
    {
      "name": "Violeta escuro italico - comentarios",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#350386",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Uva - toda pontuacao e operadores simbolicos",
      "scope": [
        "punctuation",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.accessor",
        "punctuation.definition.block.begin",
        "punctuation.definition.block.end",
        "punctuation.definition.parameters.begin",
        "punctuation.definition.parameters.end",
        "punctuation.definition.arguments.begin",
        "punctuation.definition.arguments.end",
        "punctuation.definition.array.begin",
        "punctuation.definition.array.end",
        "punctuation.definition.dictionary.begin",
        "punctuation.definition.dictionary.end",
        "punctuation.definition.string.begin",
        "punctuation.definition.string.end",
        "punctuation.definition.tag",
        "punctuation.definition.template-expression.begin",
        "punctuation.definition.template-expression.end",
        "punctuation.section.block.begin",
        "punctuation.section.block.end",
        "punctuation.section.embedded.begin",
        "punctuation.section.embedded.end",
        "meta.brace",
        "meta.brace.round",
        "meta.brace.square",
        "meta.brace.curly",
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#300576"
      }
    },
    {
      "name": "Uva escuro italico - strings",
      "scope": [
        "string",
        "string.quoted",
        "string.quoted.single",
        "string.quoted.double",
        "string.template",
        "string.unquoted",
        "text"
      ],
      "settings": {
        "foreground": "#20044e",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Preto bold - palavras reservadas da linguagem",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.control.directive",
        "keyword.other",
        "keyword.other.important",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.logical.python",
        "storage",
        "storage.type",
        "storage.modifier",
        "variable.language",
        "constant.language.this",
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#000000",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Preto bold - tipos, classes, interfaces, namespaces",
      "scope": [
        "entity.name.class",
        "entity.name.type",
        "entity.name.type.class",
        "entity.name.type.interface",
        "entity.name.type.enum",
        "entity.name.type.module",
        "entity.name.namespace",
        "entity.other.inherited-class",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#000000",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Preto - funcoes e metodos",
      "scope": [
        "entity.name.function",
        "entity.name.method",
        "support.function",
        "variable.function",
        "meta.function-call entity.name.function"
      ],
      "settings": {
        "foreground": "#000000"
      }
    },
    {
      "name": "Onix - identificadores que voce nomeia",
      "scope": [
        "variable",
        "variable.other",
        "variable.other.readwrite",
        "variable.other.constant",
        "variable.other.object",
        "variable.other.property",
        "variable.parameter",
        "support.variable",
        "meta.object-literal.key",
        "support.type.property-name",
        "support.type.property-name.json",
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#0f0f0f"
      }
    },
    {
      "name": "Preto italico - literais e escapes",
      "scope": [
        "constant",
        "constant.numeric",
        "constant.other",
        "constant.language",
        "constant.language.boolean",
        "constant.language.null",
        "constant.language.undefined",
        "constant.character.escape",
        "string.regexp",
        "meta.decorator",
        "punctuation.decorator",
        "entity.name.function.decorator"
      ],
      "settings": {
        "foreground": "#000000",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Invalido",
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#7b2ff7",
        "background": "#0f0f0f"
      }
    }
  ]
}
