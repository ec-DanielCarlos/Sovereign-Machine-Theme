      "settings": {
        "foreground": "#b1c5c8"
      }
    },
    {
      "name": "Namespaces and modules",
      "scope": [
        "entity.name.namespace",
        "entity.name.module",
        "entity.name.scope-resolution"
      ],
      "settings": {
        "foreground": "#bbc9cc"
      }
