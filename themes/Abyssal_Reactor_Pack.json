  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#7A8AA5",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Documentation comments",
      "scope": [
        "comment.block.documentation",
        "comment.block.documentation punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#8D9BB5",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Doc tags",
      "scope": [
        "storage.type.class.jsdoc",
        "punctuation.definition.block.tag.jsdoc",
        "comment keyword"
      ],
      "settings": {
        "foreground": "#8CAFE6",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Operators and separators",
      "scope": [
        "keyword.operator",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.accessor",
        "meta.delimiter"
      ],
      "settings": {
        "foreground": "#8B9CB8"
      }
    },
    {
      "name": "Brackets and delimiters",
      "scope": [
        "meta.brace",
        "meta.brace.round",
        "meta.brace.square",
        "meta.brace.curly",
        "punctuation.section.block.begin",
        "punctuation.section.block.end",
        "punctuation.section.embedded.begin",
        "punctuation.section.embedded.end",
        "punctuation.definition.parameters.begin",
        "punctuation.definition.parameters.end",
        "punctuation.definition.arguments.begin",
        "punctuation.definition.arguments.end",
        "punctuation.definition.array.begin",
        "punctuation.definition.array.end",
        "punctuation.definition.dictionary.begin",
        "punctuation.definition.dictionary.end"
      ],
      "settings": {
        "foreground": "#96A8C6"
      }
    },
    {
      "name": "Keywords and control flow",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.control.directive",
        "keyword.other.important",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.logical",
        "variable.language.this",
        "variable.language.super",
        "variable.language.self"
      ],
      "settings": {
        "foreground": "#7AB6FF",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Declarations",
      "scope": [
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#7AB6FF"
      }
    },
    {
      "name": "Imports and exports",
      "scope": [
        "keyword.control.import",
        "keyword.control.export",
        "keyword.control.from",
        "keyword.control.as"
      ],
      "settings": {
        "foreground": "#A9D0FF",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function",
        "meta.require",
        "variable.function"
      ],
      "settings": {
        "foreground": "#F6F9FF"
      }
    },
    {
      "name": "Function declaration name",
      "scope": [
        "meta.function entity.name.function",
        "meta.definition.function entity.name.function",
        "entity.name.function.member"
      ],
      "settings": {
        "foreground": "#F6F9FF",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Types and classes",
      "scope": [
        "entity.name.class",
        "entity.name.type",
        "entity.name.type.class",
        "entity.name.type.interface",
        "entity.other.inherited-class",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#DEEAFF",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Type annotations and generics",
      "scope": [
        "meta.type.annotation",
        "meta.type.parameters",
        "entity.name.type.parameter",
        "support.type.primitive",
        "support.type.builtin"
      ],
      "settings": {
        "foreground": "#B6CAF0"
      }
    },
    {
      "name": "Namespaces and modules",
      "scope": [
        "entity.name.namespace",
        "entity.name.module",
        "entity.name.scope-resolution"
      ],
      "settings": {
        "foreground": "#C1CFE6"
      }
    },
    {
      "name": "Variables",
      "scope": [
