      "settings": {
        "foreground": "#BBD3F8"
      }
    },
    {
      "name": "Tags",
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#7AB6FF"
      }
    },
    {
      "name": "Component tags",
      "scope": [
        "entity.name.tag.support",
        "meta.tag entity.name.class",
        "support.class.component"
      ],
      "settings": {
        "foreground": "#DEEAFF",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Attributes",
      "scope": [
        "entity.other.attribute-name",
        "meta.attribute"
