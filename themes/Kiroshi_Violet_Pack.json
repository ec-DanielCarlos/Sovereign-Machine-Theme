  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": { "foreground": "#6c6390", "fontStyle": "italic" }
    },
    {
      "name": "Operators and separators",
      "scope": [
        "keyword.operator",
        "punctuation.separator",
        "punctuation.terminator"
      ],
      "settings": { "foreground": "#8f86b3" }
    },
    {
      "name": "Brackets and delimiters",
      "scope": [
        "meta.brace",
        "meta.brace.round",
        "meta.brace.square",
        "meta.brace.curly",
        "punctuation.section.block.begin",
        "punctuation.section.block.end",
        "punctuation.section.embedded.begin",
        "punctuation.section.embedded.end",
        "punctuation.definition.parameters.begin",
        "punctuation.definition.parameters.end",
        "punctuation.definition.arguments.begin",
        "punctuation.definition.arguments.end",
        "punctuation.definition.array.begin",
        "punctuation.definition.array.end",
        "punctuation.definition.dictionary.begin",
        "punctuation.definition.dictionary.end"
      ],
      "settings": { "foreground": "#9b7cff" }
    },
    {
      "name": "Keywords and control flow",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.control.directive",
        "keyword.other.important"
      ],
      "settings": { "foreground": "#9b7cff", "fontStyle": "bold" }
    },
    {
      "name": "Declarations",
      "scope": [
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": { "foreground": "#c9b8ff", "fontStyle": "bold" }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function"
      ],
      "settings": { "foreground": "#f5f2ff" }
    },
    {
      "name": "Types and classes",
      "scope": [
        "entity.name.class",
        "entity.name.type",
        "entity.name.type.class",
        "entity.name.type.interface",
        "support.class",
        "support.type"
      ],
      "settings": { "foreground": "#c9b8ff", "fontStyle": "bold" }
    },
    {
      "name": "Variables and parameters",
      "scope": [
        "variable",
        "variable.parameter",
        "variable.other",
        "variable.other.readwrite",
        "variable.other.object"
      ],
      "settings": { "foreground": "#e6e0fa" }
    },
    {
      "name": "Properties and keys",
      "scope": [
        "variable.other.property",
        "meta.object-literal.key",
        "support.type.property-name",
        "support.type.property-name.json"
      ],
      "settings": { "foreground": "#9d93c4" }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "string.regexp"
      ],
      "settings": { "foreground": "#c08cff" }
    },
    {
      "name": "Escapes and constants",
      "scope": [
        "constant.character.escape",
        "constant",
        "constant.numeric",
        "constant.language",
        "constant.language.boolean",
        "constant.language.null",
        "constant.language.undefined"
      ],
      "settings": { "foreground": "#b69dff", "fontStyle": "italic" }
    },
    {
      "name": "Tags and attributes",
      "scope": [
        "entity.name.tag",
        "entity.other.attribute-name"
      ],
      "settings": { "foreground": "#c9b8ff" }
    },
    {
      "name": "Decorators",
      "scope": [
        "meta.decorator",
        "punctuation.decorator",
        "entity.name.function.decorator"
      ],
      "settings": { "foreground": "#8f7fe0" }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid"
      ],
      "settings": { "foreground": "#e08cff", "fontStyle": "underline" }
    }
  ]
}
