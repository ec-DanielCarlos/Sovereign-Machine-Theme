  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": { "foreground": "#625e74", "fontStyle": "italic" }
    },
    {
      "name": "Documentation comments",
      "scope": [
        "comment.block.documentation",
        "comment.block.documentation punctuation.definition.comment"
      ],
      "settings": { "foreground": "#625e74", "fontStyle": "italic" }
    },
    {
      "name": "Doc tags",
      "scope": [
        "storage.type.class.jsdoc",
        "punctuation.definition.block.tag.jsdoc",
        "comment keyword"
      ],
      "settings": { "foreground": "#8a5fff", "fontStyle": "italic" }
    },
    {
      "name": "Operators and separators",
      "scope": [
        "keyword.operator",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.accessor",
        "meta.delimiter"
      ],
      "settings": { "foreground": "#7d7890" }
    },
    {
      "name": "Brackets and delimiters",
      "scope": [
        "meta.brace",
        "meta.brace.round",
        "meta.brace.square",
        "meta.brace.curly",
        "punctuation.section.block.begin",
        "punctuation.section.block.end",
        "punctuation.section.embedded.begin",
        "punctuation.section.embedded.end",
        "punctuation.definition.parameters.begin",
        "punctuation.definition.parameters.end",
        "punctuation.definition.arguments.begin",
        "punctuation.definition.arguments.end",
        "punctuation.definition.array.begin",
        "punctuation.definition.array.end",
        "punctuation.definition.dictionary.begin",
        "punctuation.definition.dictionary.end"
      ],
      "settings": { "foreground": "#7d7890" }
    },
    {
      "name": "Keywords and control flow",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.control.directive",
        "keyword.other.important",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.logical",
        "variable.language.this",
        "variable.language.super",
        "variable.language.self"
      ],
      "settings": { "foreground": "#8a5fff", "fontStyle": "bold" }
    },
    {
      "name": "Declarations",
      "scope": [
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": { "foreground": "#8a5fff", "fontStyle": "italic" }
    },
    {
      "name": "Imports and exports",
      "scope": [
        "keyword.control.import",
        "keyword.control.export",
        "keyword.control.from",
        "keyword.control.as"
      ],
      "settings": { "foreground": "#8a5fff", "fontStyle": "bold italic" }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function",
        "meta.require",
        "variable.function"
      ],
      "settings": { "foreground": "#ffffff" }
    },
    {
      "name": "Function declaration name",
      "scope": [
        "meta.function entity.name.function",
        "meta.definition.function entity.name.function",
        "entity.name.function.member"
      ],
      "settings": { "foreground": "#ffffff", "fontStyle": "bold" }
    },
    {
      "name": "Types and classes",
      "scope": [
        "entity.name.class",
        "entity.name.type",
        "entity.name.type.class",
        "entity.name.type.interface",
        "entity.other.inherited-class",
        "support.class",
        "support.type"
      ],
      "settings": { "foreground": "#b8a0ff", "fontStyle": "bold" }
    },
    {
      "name": "Type annotations and generics",
      "scope": [
        "meta.type.annotation",
        "meta.type.parameters",
        "entity.name.type.parameter",
        "support.type.primitive",
        "support.type.builtin"
      ],
      "settings": { "foreground": "#b8a0ff" }
    },
    {
      "name": "Namespaces and modules",
      "scope": [
        "entity.name.namespace",
        "entity.name.module",
        "entity.name.scope-resolution"
      ],
      "settings": { "foreground": "#a9a6b6", "fontStyle": "italic" }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "variable.other",
        "variable.other.readwrite",
        "variable.other.object"
      ],
      "settings": { "foreground": "#e3e1ea" }
    },
    {
      "name": "Parameters",
      "scope": [
        "variable.parameter",
        "meta.parameter"
      ],
      "settings": { "foreground": "#e3e1ea", "fontStyle": "italic" }
    },
    {
      "name": "Properties and keys",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "meta.object-literal.key",
        "support.type.property-name",
        "support.variable.property"
      ],
      "settings": { "foreground": "#a9a6b6" }
    },
    {
      "name": "JSON keys",
      "scope": [
        "support.type.property-name.json"
      ],
      "settings": { "foreground": "#b8a0ff" }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": { "foreground": "#d6ccff" }
    },
    {
      "name": "Regular expressions",
      "scope": [
        "string.regexp",
        "string.regexp punctuation.definition.string"
      ],
      "settings": { "foreground": "#b8a0ff", "fontStyle": "italic" }
    },
    {
      "name": "Regex operators and classes",
      "scope": [
        "keyword.operator.quantifier.regexp",
        "keyword.control.anchor.regexp",
        "constant.other.character-class.regexp",
        "punctuation.definition.group.regexp"
      ],
      "settings": { "foreground": "#8a5fff" }
    },
    {
      "name": "Template expression punctuation",
      "scope": [
        "punctuation.definition.template-expression.begin",
        "punctuation.definition.template-expression.end",
        "punctuation.section.embedded"
      ],
      "settings": { "foreground": "#8a5fff", "fontStyle": "bold" }
    },
    {
      "name": "Escapes",
      "scope": [
        "constant.character.escape",
        "constant.character.entity"
      ],
      "settings": { "foreground": "#ffffff", "fontStyle": "bold" }
    },
    {
      "name": "Numbers and constants",
      "scope": [
        "constant",
        "constant.numeric",
        "constant.language",
        "constant.language.boolean",
        "constant.language.null",
        "constant.language.undefined",
        "constant.other",
        "variable.other.constant"
      ],
      "settings": { "foreground": "#b8a0ff", "fontStyle": "italic" }
    },
    {
      "name": "Tags",
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": { "foreground": "#8a5fff", "fontStyle": "bold" }
    },
    {
      "name": "Component tags",
      "scope": [
        "entity.name.tag.support",
        "meta.tag entity.name.class",
        "support.class.component"
      ],
      "settings": { "foreground": "#b8a0ff", "fontStyle": "bold" }
    },
    {
      "name": "Attributes",
      "scope": [
        "entity.other.attribute-name",
        "meta.attribute"
      ],
      "settings": { "foreground": "#a9a6b6", "fontStyle": "italic" }
    },
    {
      "name": "CSS selectors",
      "scope": [
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css",
        "entity.other.attribute-name.pseudo-class.css",
        "entity.other.attribute-name.pseudo-element.css"
      ],
      "settings": { "foreground": "#8a5fff" }
    },
    {
      "name": "CSS properties",
      "scope": [
        "support.type.property-name.css",
        "meta.property-name.css"
      ],
      "settings": { "foreground": "#a9a6b6" }
    },
    {
      "name": "CSS values and units",
      "scope": [
        "support.constant.property-value.css",
        "keyword.other.unit.css",
        "constant.numeric.css"
      ],
      "settings": { "foreground": "#d6ccff" }
    },
    {
      "name": "Decorators",
      "scope": [
        "meta.decorator",
        "punctuation.decorator",
        "entity.name.function.decorator",
        "meta.decorator variable.other"
      ],
      "settings": { "foreground": "#8a5fff", "fontStyle": "italic" }
    },
    {
      "name": "Markdown headings",
      "scope": [
        "markup.heading",
        "markup.heading entity.name",
        "punctuation.definition.heading"
      ],
      "settings": { "foreground": "#8a5fff", "fontStyle": "bold" }
    },
    {
      "name": "Markdown bold",
      "scope": [
        "markup.bold"
      ],
      "settings": { "foreground": "#ffffff", "fontStyle": "bold" }
    },
    {
      "name": "Markdown italic",
      "scope": [
        "markup.italic"
      ],
      "settings": { "foreground": "#e3e1ea", "fontStyle": "italic" }
    },
    {
      "name": "Markdown links",
      "scope": [
        "markup.underline.link",
        "string.other.link",
        "constant.other.reference.link"
      ],
      "settings": { "foreground": "#b8a0ff", "fontStyle": "underline" }
    },
    {
      "name": "Markdown code and quotes",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code",
        "markup.raw",
        "markup.quote"
      ],
      "settings": { "foreground": "#d6ccff" }
    },
    {
      "name": "Markdown lists and rules",
      "scope": [
        "punctuation.definition.list.begin",
        "markup.list",
        "meta.separator"
      ],
      "settings": { "foreground": "#8a5fff" }
    },
    {
      "name": "Diff inserted",
      "scope": [
        "markup.inserted",
        "markup.inserted punctuation.definition"
      ],
      "settings": { "foreground": "#b8a0ff" }
    },
    {
      "name": "Diff deleted",
      "scope": [
        "markup.deleted",
        "markup.deleted punctuation.definition"
      ],
      "settings": { "foreground": "#625e74" }
    },
    {
      "name": "Diff changed",
      "scope": [
        "markup.changed",
        "markup.changed punctuation.definition"
      ],
      "settings": { "foreground": "#8a5fff" }
    },
    {
      "name": "YAML and TOML keys",
      "scope": [
        "entity.name.tag.yaml",
        "variable.other.key.toml",
        "entity.name.section.toml"
      ],
      "settings": { "foreground": "#b8a0ff" }
    },
    {
      "name": "Shell variables and builtins",
      "scope": [
        "variable.other.normal.shell",
        "support.function.builtin.shell",
        "punctuation.definition.variable.shell"
      ],
      "settings": { "foreground": "#b8a0ff", "fontStyle": "italic" }
    },
    {
      "name": "Preprocessor and annotations",
      "scope": [
        "meta.preprocessor",
        "entity.name.function.preprocessor",
        "storage.type.annotation"
      ],
      "settings": { "foreground": "#8a5fff", "fontStyle": "italic" }
    },
    {
      "name": "Deprecated",
      "scope": [
        "markup.strikethrough",
        "entity.name.function.deprecated"
      ],
      "settings": { "foreground": "#625e74", "fontStyle": "strikethrough" }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": { "foreground": "#ffffff", "background": "#5b1eff" }
    },
    {
      "name": "Invalid deprecated",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": { "foreground": "#b8a0ff", "fontStyle": "strikethrough" }
    }
  ]
}
