{
  "name": "Sovereign Machine Kiroshi Violet Pack",
  "$schema": "vscode://schemas/color-theme",
  "type": "dark",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "keyword": { "foreground": "#8a5fff", "bold": true },
    "modifier": { "foreground": "#8a5fff", "italic": true },
    "class": { "foreground": "#b8a0ff", "bold": true },
    "interface": { "foreground": "#b8a0ff", "bold": true, "italic": true },
    "type": { "foreground": "#b8a0ff", "bold": true },
    "typeParameter": { "foreground": "#b8a0ff", "italic": true },
    "enum": { "foreground": "#b8a0ff", "bold": true },
    "struct": { "foreground": "#b8a0ff", "bold": true },
    "namespace": { "foreground": "#a9a6b6", "italic": true },
    "function": "#ffffff",
    "function.declaration": { "foreground": "#ffffff", "bold": true },
    "method": "#ffffff",
    "method.declaration": { "foreground": "#ffffff", "bold": true },
    "macro": { "foreground": "#8a5fff", "italic": true },
    "variable": "#e3e1ea",
    "variable.readonly": { "foreground": "#e3e1ea", "italic": true },
    "variable.defaultLibrary": { "foreground": "#b8a0ff", "italic": true },
    "parameter": { "foreground": "#e3e1ea", "italic": true },
    "property": "#a9a6b6",
    "property.readonly": { "foreground": "#a9a6b6", "italic": true },
    "event": "#a9a6b6",
    "number": { "foreground": "#b8a0ff", "italic": true },
    "enumMember": { "foreground": "#b8a0ff", "italic": true },
    "decorator": { "foreground": "#8a5fff", "italic": true },
    "regexp": { "foreground": "#b8a0ff", "italic": true },
    "string": "#d6ccff",
    "operator": "#7d7890",
    "comment": { "foreground": "#625e74", "italic": true },
    "*.deprecated": {
      "strikethrough": true
    }
  },
