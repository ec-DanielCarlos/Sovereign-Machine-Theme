      "settings": {
        "foreground": "#a06bff",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#e6e3ee",
        "fontStyle": "bold"
      }
