  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#6b6777",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Documentation comments",
      "scope": [
        "comment.block.documentation",
        "comment.block.documentation punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#7c7889",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Doc tags",
      "scope": [
        "storage.type.class.jsdoc",
        "punctuation.definition.block.tag.jsdoc",
        "comment keyword"
      ],
      "settings": {
        "foreground": "#8f7db8",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Operators and separators",
      "scope": [
        "keyword.operator",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.accessor",
        "meta.delimiter"
      ],
      "settings": {
        "foreground": "#858191"
      }
    },
    {
      "name": "Brackets and delimiters",
      "scope": [
        "meta.brace",
        "meta.brace.round",
        "meta.brace.square",
        "meta.brace.curly",
        "punctuation.section.block.begin",
        "punctuation.section.block.end",
        "punctuation.section.embedded.begin",
        "punctuation.section.embedded.end",
        "punctuation.definition.parameters.begin",
        "punctuation.definition.parameters.end",
        "punctuation.definition.arguments.begin",
        "punctuation.definition.arguments.end",
        "punctuation.definition.array.begin",
        "punctuation.definition.array.end",
        "punctuation.definition.dictionary.begin",
        "punctuation.definition.dictionary.end"
      ],
      "settings": {
        "foreground": "#8f8a9c"
      }
    },
    {
      "name": "Keywords and control flow",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.control.directive",
        "keyword.other.important",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.logical",
        "variable.language.this",
        "variable.language.super",
        "variable.language.self"
      ],
      "settings": {
        "foreground": "#a06bff",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Declarations",
      "scope": [
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#a06bff"
      }
    },
    {
      "name": "Imports and exports",
      "scope": [
        "keyword.control.import",
        "keyword.control.export",
        "keyword.control.from",
        "keyword.control.as"
      ],
      "settings": {
        "foreground": "#b088ff",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function",
        "meta.require",
        "variable.function"
      ],
      "settings": {
        "foreground": "#f4f2f8"
      }
    },
    {
      "name": "Function declaration name",
      "scope": [
        "meta.function entity.name.function",
        "meta.definition.function entity.name.function",
        "entity.name.function.member"
      ],
      "settings": {
        "foreground": "#f4f2f8",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Types and classes",
      "scope": [
        "entity.name.class",
        "entity.name.type",
        "entity.name.type.class",
        "entity.name.type.interface",
        "entity.other.inherited-class",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#dedae8",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Type annotations and generics",
      "scope": [
        "meta.type.annotation",
        "meta.type.parameters",
        "entity.name.type.parameter",
        "support.type.primitive",
        "support.type.builtin"
      ],
      "settings": {
        "foreground": "#b3aec6"
      }
    },
    {
      "name": "Namespaces and modules",
      "scope": [
        "entity.name.namespace",
        "entity.name.module",
        "entity.name.scope-resolution"
      ],
      "settings": {
        "foreground": "#bdb9ca"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "variable.other",
        "variable.other.readwrite",
        "variable.other.object"
      ],
      "settings": {
        "foreground": "#cbc7d6"
      }
    },
    {
      "name": "Parameters",
      "scope": [
        "variable.parameter",
        "meta.parameter"
      ],
      "settings": {
        "foreground": "#bdb9ca",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Properties and keys",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "meta.object-literal.key",
        "support.type.property-name",
        "support.variable.property"
