        "foreground": "#c3bad8"
      }
    },
    {
      "name": "Tags",
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#a06bff"
      }
    },
    {
      "name": "Component tags",
      "scope": [
        "entity.name.tag.support",
        "meta.tag entity.name.class",
        "support.class.component"
      ],
      "settings": {
        "foreground": "#dedae8",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Attributes",
      "scope": [
        "entity.other.attribute-name",
        "meta.attribute"
