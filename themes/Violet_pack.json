    {
      "name": "Diff inserted",
      "scope": [
        "markup.inserted",
        "markup.inserted punctuation.definition"
      ],
      "settings": {
        "foreground": "#86a37f"
      }
    },
    {
      "name": "Diff deleted",
      "scope": [
        "markup.deleted",
        "markup.deleted punctuation.definition"
      ],
      "settings": {
        "foreground": "#c8615e"
      }
    },
    {
      "name": "Diff changed",
      "scope": [
        "markup.changed",
        "markup.changed punctuation.definition"
      ],
      "settings": {
        "foreground": "#c9ab72"
      }
    },
    {
      "name": "YAML and TOML keys",
      "scope": [
        "entity.name.tag.yaml",
