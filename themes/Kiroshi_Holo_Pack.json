      "settings": {
        "foreground": "#A3F3FF",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function"
      ],
      "settings": {
        "foreground": "#ECFDFF"
      }
    },
    {
      "name": "Types and classes",
      "scope": [
        "entity.name.class",
        "entity.name.type",
        "entity.name.type.class",
        "entity.name.type.interface",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#A3F3FF",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Variables and parameters",
      "scope": [
        "variable",
        "variable.parameter",
        "variable.other",
        "variable.other.readwrite",
        "variable.other.object"
      ],
      "settings": {
        "foreground": "#D8F4FA"
      }
    },
    {
      "name": "Properties and keys",
      "scope": [
        "variable.other.property",
