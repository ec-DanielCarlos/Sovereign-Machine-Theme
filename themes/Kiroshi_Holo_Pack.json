        "support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#8DC5D8"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#A0DACC"
      }
    },
    {
      "name": "Escapes and constants",
      "scope": [
        "constant.character.escape",
        "constant",
        "constant.numeric",
        "constant.language",
        "constant.language.boolean",
        "constant.language.null",
        "constant.language.undefined"
